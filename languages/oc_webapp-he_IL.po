msgid "Original Concepts App"
msgstr "אפליקציית אוריג'ינל קונספטס"

msgid "Settings to fit your pages inside the Original Concepts app"
msgstr "הגדרות להתאמת העמודים בתוך אפליקציית אוריג'ינל קונספטס"

msgid "Comma-separated selectors to hide inside the app"
msgstr "סלקטורים מופרדים בפסיק להסתרה בתוך האפליקציה"

msgid "App WebView user-agent substring"
msgstr "מחרוזת ה-User-Agent של ה-WebView באפליקציה"

msgid "Custom HTTP header for the user-agent (optional)"
msgstr "כותרת HTTP מותאמת ל-User-Agent (אופציונלי)"

msgid "Example: header, .site-footer, #download-app-popup"
msgstr "לדוגמה: header, .site-footer, #download-app-popup"

msgid "Web Application"
msgstr "אפליקציה"

msgid "Restrict to app users only"
msgstr "הגבל למשתמשי אפליקציה בלבד"

msgid "When checked, this coupon works only for shoppers browsing inside the app."
msgstr "כשמסומן, הקופון יעבוד רק עבור לקוחות שגולשים בתוך האפליקציה."

msgid "This coupon can only be used in the app."
msgstr "הקופון לשימוש באפליקציה בלבד"

msgid "OC Webapp: checked GitHub for updates."
msgstr "OC Webapp: נבדקו עדכונים ב-GitHub."

msgid "OC Webapp updates from GitHub releases."
msgstr "OC Webapp מתעדכן מ-Releases ב-GitHub."

msgid "Check for updates now"
msgstr "בדוק עדכונים עכשיו"

msgid "Permission denied."
msgstr "אין הרשאה."

msgid "Download-app banner"
msgstr "באנר הורדת האפליקציה"

msgid "A small bar that invites visitors to download the app. It detects whether the visitor is on iPhone or Android and links to the matching store."
msgstr "פס קטן שמזמין את הגולשים להוריד את האפליקציה. הבאנר מזהה לבד אם הגולש באייפון או באנדרואיד ומפנה לחנות המתאימה."

msgid "Enable"
msgstr "הפעלה"

msgid "Show the download-app banner"
msgstr "הצג את באנר הורדת האפליקציה"

msgid "Where to show"
msgstr "איפה להציג"

msgid "Mobile browser"
msgstr "דפדפן בנייד"

msgid "Desktop"
msgstr "מחשב (דסקטופ)"

msgid "Inside the app"
msgstr "בתוך האפליקציה"

msgid "Hidden"
msgstr "לא להציג"

msgid "Top of the page"
msgstr "בראש העמוד"

msgid "Bottom of the screen"
msgstr "בתחתית המסך"

msgid "App Store link (iPhone)"
msgstr "קישור ל-App Store (אייפון)"

msgid "Google Play link (Android)"
msgstr "קישור ל-Google Play (אנדרואיד)"

msgid "On a phone only the button of the matching store is shown. If that store's link is empty, the banner is not shown on that phone."
msgstr "בטלפון מוצג רק הכפתור של החנות המתאימה למכשיר. אם הקישור לחנות הזו ריק, הבאנר לא יוצג באותו מכשיר."

msgid "App icon"
msgstr "אייקון האפליקציה"

msgid "Use this image"
msgstr "בחירה בתמונה זו"

msgid "Choose image"
msgstr "בחירת תמונה"

msgid "Square image. If empty, the site icon is used."
msgstr "תמונה ריבועית. אם ריק, יוצג אייקון האתר."

msgid "Title"
msgstr "כותרת"

msgid "Text"
msgstr "טקסט"

msgid "Button text"
msgstr "טקסט הכפתור"

msgid "Leave a text field empty to use the default shown in it."
msgstr "שדה טקסט שיישאר ריק יציג את ברירת המחדל שמופיעה בו."

msgid "Button color"
msgstr "צבע הכפתור"

msgid "Show again after closing"
msgstr "הצגה מחדש אחרי סגירה"

msgid "days (0 = on the next page)"
msgstr "ימים (0 = כבר בעמוד הבא)"

msgid "Download the app"
msgstr "הורידו את האפליקציה"

msgid "Faster, easier shopping from your phone"
msgstr "קנייה מהירה ונוחה יותר מהטלפון"

msgid "Download"
msgstr "להורדה"

msgid "Close"
msgstr "סגירה"
